  "meta": {
    "project": "tencentdb-agent-memory — tmem view",
    "designRead": {
      "pageKind": "dashboard",
      "audience": "the person whose memory this is — a bilingual senior engineer opening tmem view between coding sessions, not the plugin's author debugging it",
      "job": "fix the one thing that is quietly degrading their memory right now",
      "vibe": "plain-spoken, calm, reads like a short report a colleague wrote",
      "systemFamily": "named approximation: \"plain report\" — system-ui + the dataviz mark specs, no component framework, zero dependencies (ADR-01)"
    },
    "dials": {
      "variance": 4,
      "motion": 1,
      "density": 5,
      "reason": "variance 4: the audit found the current page's one non-conventional move (the hatch \"not measured\" mark) is also its best, so this keeps a conventional dashboard skeleton and spends its one risk on the verdict sentence replacing the hero number — a dashboard that leads with a sentence instead of a figure is unusual enough to be the signature and boring enough to be trusted. motion 1: the surface is served over SSE and re-renders under the reader, so animation would compete with a genuine change signal; the built page already has zero transitions and that is right, not an omission. density 5: down from the audited 9 — the first viewport must carry a verdict and three problems, not seventeen numbers — but not lower, because a person with 51 stores is looking at a portfolio and airy marketing spacing would push the third problem below the fold."
    },
    "chosenCandidate": "A — Plain report (see .design-flow/preview/candidates/ for B and C, both gate-clean)"
  },
